{
  "name": "bookstore-server",
  "version": "1.0.0",
  "description": "Bookstore API with Node.js, Express, MongoDB, TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
